      "LookupRequest": {
        "properties": {
          "search_terms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Search Terms",
            "description": "Company names or national registry IDs",
            "examples": [
              [
                "Danone",
                "Equinor",
                "0112038-9",
                "04788290"
              ]
            ]
          },
          "countries": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Countries",
            "description": "ISO 3166-1 alpha-2 country codes (FR, NO, FI, CZ). If omitted, searches all.",
            "examples": [
              [
                "FR",
                "NO",
                "FI",
                "CZ"
              ]
            ]
          },
          "max_results_per_query": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Results Per Query",
            "description": "Maximum results per search term (1-20)",
            "default": 5
          },
          "validate_vat": {
            "type": "boolean",
            "title": "Validate Vat",
