{
  "openapi": "3.1.0",
  "info": {
    "title": "European Company Registry & KYB API",
    "description": "Resolve company names or national registry IDs into clean, normalized records pulled **directly from official government registries** across Europe. Covers France (INSEE/RNE), Norway (Br\u00f8nn\u00f8ysund), Finland (PRH/YTJ), and Czechia (ARES), plus EU VAT validation (VIES) and LEI lookup (GLEIF). Authenticate via `X-API-Key` or `X-RapidAPI-Proxy-Secret` header.",
    "version": "1.0.0",
    "x-logo": {
      "url": "https://example.com/logo.png",
      "altText": "KYB API Logo"
    }
  },
  "paths": {
    "/kyb/lookup": {
      "post": {
        "tags": [
          "KYB Lookup"
        ],
        "summary": "Batch Lookup",
        "description": "Batch company lookup by name or national registry ID.\n\nFetches data directly from official government registries across Europe:\n- France: INSEE / RNE (SIREN)\n- Norway: Br\u00f8nn\u00f8ysund (Org.nr)\n- Finland: PRH / YTJ (Y-tunnus)\n- Czechia: ARES (I\u010cO)\n\nPlus EU VAT validation (VIES) and LEI lookup (GLEIF).",
        "operationId": "batch_lookup_kyb_lookup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LookupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LookupResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/kyb/company/{country}/{company_id}": {
      "get": {
        "tags": [
          "KYB Lookup"
        ],
        "summary": "Single Lookup",
        "description": "Lookup a single company by country and national registry ID.\n\nExample:\n- GET /kyb/company/FR/552032534  (Danone)\n- GET /kyb/company/NO/916385699  (Equinor)\n- GET /kyb/company/FI/0112038-9  (Nokia)",
        "operationId": "single_lookup_kyb_company__country___company_id__get",
        "parameters": [
          {
            "name": "country",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Country"
            }
          },
          {
            "name": "company_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Company Id"
            }
          },
          {
            "name": "validate_vat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Check VAT number via EU VIES",
              "default": true,
              "title": "Validate Vat"
            },
            "description": "Check VAT number via EU VIES"
          },
          {
            "name": "lookup_lei",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Fetch LEI from GLEIF",
              "default": true,
              "title": "Lookup Lei"
            },
            "description": "Fetch LEI from GLEIF"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
